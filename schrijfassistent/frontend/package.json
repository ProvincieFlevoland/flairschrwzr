{
  "name": "schrijfassistent-bundle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schrijfassistent GS-nota editor as a Svelte 5 bundle mounted by the GovChat-NL overlay loader.js (see schrijfassistent/README.md).",
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:css-scope": "node scripts/check-css-scope.mjs",
    "check:dark-twins": "node scripts/check-dark-twins.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:harness": "node dev/serve.mjs",
    "build:lexicons": "node scripts/build-b1-lexicons.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "postcss": "^8.4.32",
    "postcss-selector-parser": "^6.1.2",
    "svelte": "^5.54.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2"
  }
}
