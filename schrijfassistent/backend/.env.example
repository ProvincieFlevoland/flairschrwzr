# Local settings for the Schrijfassistent backend. Copy to `.env` in this folder (it is git-ignored) and fill in.
# In Azure the same names are set as environment variables on the backend Container App
# (see schrijfassistent/OPERATIONS.md, section 2); an environment variable always wins over this file.

# --- AI: the Azure AI Foundry project that holds the deployment "chat-agent" ---------------------------------
# Needs `az login` on this machine (DefaultAzureCredential). In Azure the Container App'0s managed identity is used.
# TODO: wordt omgezet naar litellm 
PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>

# --- Storage: notas and configurations (blob container) ------------------------------------------------------
# Leave it empty to let `schrijfassistent/dev/run-local-dev.sh` use its local blob emulator (nothing is written to Azure).
# For real storage fill in the connection string of the storage account.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=schrijfassistentdocs

# --- Auth: every request must carry an Open WebUI bearer token, verified against Open WebUI ------------------
# Required. The base URL of Open WebUI as the backend reaches it (in Azure: its internal URL).
OPENWEBUI_INTERNAL_URL=http://localhost:3000
# Origins that may call the backend from a browser (comma separated).
# CORS_ALLOW_ORIGINS=http://localhost:3000
